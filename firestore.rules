rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents: users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollection: bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) && isValidId(bookmarkId);
      }

      // Subcollection: calculationNotes
      match /calculationNotes/{noteId} {
        allow read, write: if isOwner(userId) && isValidId(noteId);
      }

      // Subcollection: sldAnnotations
      match /sldAnnotations/{annotationId} {
        allow read, write: if isOwner(userId) && isValidId(annotationId);
      }
    }
  }
}
